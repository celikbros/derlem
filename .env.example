APP_ENV=development
HTTP_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/derlem?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=derlem
JWT_TTL=8h
SESSION_IDLE_TTL=30m
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=30
BOOTSTRAP_ADMIN_EMAIL=admin@derlem.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
STORAGE_ROOT=./var/storage
STAGING_ROOT=./var/staging
MAX_UPLOAD_BYTES=53687091200
WORKER_POLL_INTERVAL=2s
DOCUMENT_SAMPLE_SIZE=200
MAX_DOCUMENT_BYTES=262144
