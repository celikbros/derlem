# Derlem production environment template.
# Copy to /etc/derlem/derlem.env on the server and replace every CHANGE_ME value.

APP_ENV=production

# Bind API only to localhost when Nginx is the public entrypoint.
HTTP_ADDR=127.0.0.1:8080
WEB_ORIGIN=https://derlem.example.com

DATABASE_URL=postgresql://derlem:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/derlem?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
JWT_ISSUER=derlem
JWT_TTL=8h
SESSION_IDLE_TTL=30m
LOGIN_FAILURE_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m
LOGIN_ACCOUNT_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=30

# Set only for first bootstrap. After the admin user exists, remove or leave empty.
BOOTSTRAP_ADMIN_EMAIL=admin@derlem.example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD

STORAGE_ROOT=/var/lib/derlem/storage
STAGING_ROOT=/var/lib/derlem/staging
MAX_UPLOAD_BYTES=53687091200
WORKER_POLL_INTERVAL=2s
DOCUMENT_SAMPLE_SIZE=200
MAX_DOCUMENT_BYTES=262144

# Used by the Next.js server-side API proxy.
DERLEM_API_URL=http://127.0.0.1:8080

# Keep blank in production. Local credential display is only for local development.
NEXT_PUBLIC_LOCAL_LOGIN_EMAIL=
NEXT_PUBLIC_LOCAL_LOGIN_PASSWORD=
NEXT_PUBLIC_LOCAL_TEST_ACCOUNTS=
