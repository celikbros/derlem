[Unit]
Description=Derlem Go API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=derlem
Group=derlem
WorkingDirectory=/opt/derlem/current
EnvironmentFile=/etc/derlem/derlem.env
ExecStart=/opt/derlem/current/bin/derlem-api
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/derlem

[Install]
WantedBy=multi-user.target
