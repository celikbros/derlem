{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turkce Veri Atolyesi Conversation Sample",
  "type": "object",
  "required": [
    "sample_id",
    "content_purpose",
    "messages",
    "created_at"
  ],
  "properties": {
    "sample_id": { "type": "string" },
    "source_id": { "type": "string" },
    "task_type": { "type": "string" },
    "content_purpose": {
      "type": "string",
      "enum": [
        "pretrain",
        "instruction",
        "preference",
        "eval",
        "holdout",
        "post_training"
      ]
    },
    "language": { "type": "string" },
    "domain": { "type": "string" },
    "train_policy": {
      "type": "string",
      "enum": [
        "assistant_only",
        "full_dialogue",
        "no_train",
        "eval_only"
      ]
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "message_id": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["system", "developer", "user", "assistant", "tool", "other"]
          },
          "name": { "type": "string" },
          "content": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text",
                        "image",
                        "image_url",
                        "video",
                        "video_url",
                        "audio",
                        "audio_url",
                        "tool_reference"
                      ]
                    },
                    "text": { "type": "string" },
                    "asset_ref": { "type": "string" },
                    "url": { "type": "string" },
                    "mime_type": { "type": "string" },
                    "metadata": { "type": "object" }
                  },
                  "additionalProperties": true
                }
              }
            ]
          },
          "reasoning_content": { "type": "string" },
          "reasoning_visibility": {
            "type": "string",
            "enum": ["hidden", "review_only", "export_allowed"]
          },
          "tool_call_id": { "type": "string" },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "arguments"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "arguments": { "type": "object" }
              },
              "additionalProperties": true
            }
          },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "schema"],
        "properties": {
          "name": { "type": "string" },
          "schema": { "type": "object" },
          "defer_loading": { "type": "boolean" },
          "strict": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "renderings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adapter_id", "rendered_prompt_sha256"],
        "properties": {
          "adapter_id": { "type": "string" },
          "render_config": { "type": "object" },
          "rendered_prompt_sha256": { "type": "string" },
          "rendered_prompt_object_uri": { "type": "string" },
          "token_count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "export_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["profile_id", "name", "purpose", "schema_version"],
        "properties": {
          "profile_id": { "type": "string" },
          "name": {
            "type": "string",
            "enum": [
              "canonical_messages",
              "instruction_jsonl",
              "preference_jsonl",
              "eval_jsonl",
              "pretrain_text"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "pretrain",
              "instruction",
              "preference",
              "eval",
              "holdout",
              "post_training"
            ]
          },
          "schema_version": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string" }
  },
  "additionalProperties": false
}
