{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://derlem.local/schemas/conversation_sample.schema.json",
  "title": "Derlem Canonical Conversation or Preference Sample",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "sample_id",
    "content_purpose"
  ],
  "properties": {
    "schema_version": { "const": "derlem.canonical-sample.v1" },
    "record_type": { "enum": ["conversation", "preference"] },
    "sample_id": { "type": "string", "minLength": 1 },
    "content_purpose": {
      "enum": ["pretrain", "instruction", "preference", "eval", "holdout", "post_training"]
    },
    "task_type": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "train_policy": {
      "enum": ["assistant_only", "full_dialogue", "no_train", "eval_only"]
    },
    "messages": {
      "type": "array",
      "items": { "$ref": "#/$defs/message" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "preference": {
      "type": "object",
      "required": ["chosen", "rejected"],
      "properties": {
        "chosen": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        },
        "rejected": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/message" }
        }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "record_type": { "const": "conversation" } } },
      "then": {
        "required": ["messages"],
        "properties": { "messages": { "minItems": 1 } },
        "not": { "required": ["preference"] }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "preference" } } },
      "then": {
        "required": ["preference"],
        "properties": { "content_purpose": { "const": "preference" } }
      }
    }
  ],
  "$defs": {
    "message": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "message_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["system", "developer", "user", "assistant", "tool", "other"] },
        "name": { "type": "string", "minLength": 1 },
        "content": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/content_part" }
            }
          ]
        },
        "reasoning_content": { "type": "string", "minLength": 1 },
        "reasoning_visibility": { "enum": ["hidden", "review_only", "export_allowed"] },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "tool_calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/tool_call" }
        },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "content_part": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["text", "image", "image_url", "video", "video_url", "audio", "audio_url", "tool_reference"]
        },
        "text": { "type": "string", "minLength": 1 },
        "asset_ref": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "input_schema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "input_schema": { "type": "object" },
        "strict": { "type": "boolean" },
        "defer_loading": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "tool_call": {
      "type": "object",
      "required": ["id", "name", "arguments"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
