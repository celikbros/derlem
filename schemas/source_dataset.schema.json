{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turkce Veri Atolyesi Source Dataset",
  "type": "object",
  "required": [
    "source_id",
    "name",
    "source_type",
    "content_purpose",
    "language",
    "domain",
    "license",
    "rights_status",
    "usage_permission",
    "raw_path",
    "sha256",
    "risk_level",
    "pii_status",
    "approval_status",
    "created_by",
    "status",
    "created_at"
  ],
  "properties": {
    "source_id": { "type": "string" },
    "name": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": [
        "web_crawl",
        "book",
        "article",
        "wiki",
        "news",
        "academic",
        "code",
        "human_contribution",
        "internal_document",
        "other"
      ]
    },
    "content_purpose": {
      "type": "string",
      "enum": [
        "pretrain",
        "instruction",
        "preference",
        "eval",
        "holdout",
        "post_training",
        "unknown"
      ]
    },
    "language": { "type": "string" },
    "language_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "script": { "type": "string" },
    "domain": { "type": "string" },
    "genre": { "type": "string" },
    "license": { "type": "string" },
    "rights_status": {
      "type": "string",
      "enum": [
        "cleared",
        "public_domain",
        "licensed",
        "research_only",
        "unknown",
        "blocked"
      ]
    },
    "source_url": { "type": "string" },
    "license_evidence_ref": { "type": "string" },
    "lineage_ref": { "type": "string" },
    "usage_permission": {
      "type": "string",
      "enum": [
        "pretraining_allowed",
        "research_only",
        "eval_only",
        "needs_legal_review",
        "not_allowed"
      ]
    },
    "redistribution_allowed": { "type": "boolean" },
    "raw_path": { "type": "string" },
    "original_path": { "type": "string" },
    "immutable_object_uri": { "type": "string" },
    "immutable_object_sha256": { "type": "string" },
    "normalized_path": { "type": "string" },
    "approved_path": { "type": "string" },
    "sha256": { "type": "string" },
    "raw_bytes": { "type": "integer", "minimum": 0 },
    "line_count": { "type": "integer", "minimum": 0 },
    "document_count": { "type": "integer", "minimum": 0 },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "pii_risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "pii_status": {
      "type": "string",
      "enum": [
        "not_scanned",
        "clear",
        "warning",
        "blocked",
        "quarantined"
      ]
    },
    "copyright_risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "sensitive_domain": { "type": "boolean" },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "dedup": {
      "type": "object",
      "properties": {
        "group": { "type": "string" },
        "method": { "type": "string" },
        "exact_done": { "type": "boolean" },
        "near_done": { "type": "boolean" },
        "report_path": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "source_registered",
        "license_review",
        "raw_ingested",
        "normalized",
        "auto_filtered",
        "pii_checked",
        "deduped",
        "sampled_for_human_review",
        "approved",
        "rejected",
        "release_candidate",
        "frozen_release"
      ]
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "approved",
        "rejected",
        "quarantined",
        "frozen"
      ]
    },
    "split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "hidden_eval",
        "holdout",
        "post_training",
        "unassigned"
      ]
    },
    "train_allowed": { "type": "boolean" },
    "eval_allowed": { "type": "boolean" },
    "tokenizer_allowed": { "type": "boolean" },
    "reviewer": { "type": "string" },
    "review_notes": { "type": "string" },
    "created_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
